generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js Models ──────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  profile   Profile?
  programs  TrainingProgram[]
  volumeTracking VolumeTracking[]
  progress  Progress[]
  workoutSessions WorkoutSession[]
  mealEntries MealEntry[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id              String  @id @default(cuid())
  userId          String  @unique
  age             Int?
  experienceLevel String? // beginner, intermediate, advanced
  goals           String? // muscle_gain, fat_loss, strength, endurance
  equipment       String? // full_gym, home_gym, bodyweight_only
  injuries        String?
  gender          String? // male, female, other
  weight          Float?  // kg
  height          Float?  // cm
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  medicalHistory MedicalHistory[]
}

model MedicalHistory {
  id        String  @id @default(cuid())
  profileId String
  condition String
  severity  String? // mild, moderate, severe
  notes     String?
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ─── Exercise Database Models ─────────────────────────────────────────

model Exercise {
  id          String  @id @default(cuid())
  name        String  @unique
  nameEs      String?
  slug        String? @unique
  instructions String?
  gifUrl      String?
  bodyPart    String?
  category    String?
  muscle      String?

  muscleGroupId String?
  muscleGroup   MuscleGroup? @relation(fields: [muscleGroupId], references: [id])

  equipmentId String?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id])

  media         ExerciseMedia[]
  substitutions Exercise[] @relation("ExerciseSubstitutions")
  substitutedBy Exercise[] @relation("ExerciseSubstitutions")

  workoutExercises WorkoutExercise[]
}

model MuscleGroup {
  id       String @id @default(cuid())
  name     String @unique
  nameEs   String?
  category String? // chest, back, legs, shoulders, arms, core

  exercises Exercise[]
}

model Equipment {
  id   String @id @default(cuid())
  name String @unique
  nameEs String?

  exercises Exercise[]
}

model ExerciseMedia {
  id         String  @id @default(cuid())
  exerciseId String
  type       String  // gif, video, image
  url        String
  isPrimary  Boolean @default(false)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

// ─── Training Program Models ──────────────────────────────────────────

model TrainingProgram {
  id        String    @id @default(cuid())
  userId    String
  name      String
  splitType String?   // push_pull_legs, upper_lower, full_body, custom
  startDate DateTime?
  endDate   DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  days      WorkoutDay[]
  sessions  WorkoutSession[]
}

model WorkoutDay {
  id       String @id @default(cuid())
  programId String
  dayNumber Int
  name      String? // push_day, pull_day, leg_day
  program   TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercises WorkoutExercise[]
  sessions  WorkoutSession[]
}

model WorkoutExercise {
  id         String @id @default(cuid())
  dayId      String
  exerciseId String
  sets       Int?
  reps       Int?
  weight     Float?
  rpe        Float?
  order      Int
  day        WorkoutDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exercise   Exercise   @relation(fields: [exerciseId], references: [id])
  workoutSets WorkoutSet[]
}

// ─── Workout Logging Models ───────────────────────────────────────────

model WorkoutSession {
  id          String    @id @default(cuid())
  userId      String
  programId   String
  dayId       String
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  program TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  day     WorkoutDay      @relation(fields: [dayId], references: [id], onDelete: Cascade)
}

model WorkoutSet {
  id                 String  @id @default(cuid())
  workoutExerciseId String
  setNumber          Int
  reps               Int?
  weight             Float?
  rpe                Float?
  completed          Boolean @default(false)
  workoutExercise    WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
}

model VolumeTracking {
  id         String @id @default(cuid())
  userId     String
  muscleGroup String
  week       String // ISO week, e.g., "2026-W35"
  sets       Int
  volumeLoad Float? // weight * reps * sets
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, muscleGroup, week])
}

// ─── Progress Models ──────────────────────────────────────────────────

model Progress {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime @default(now())
  bodyWeight   Float?
  estimated1RM Float?
  notes        String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Nutrition Models ─────────────────────────────────────────────────

model MealEntry {
  id        String   @id @default(cuid())
  userId    String
  name      String
  calories  Int
  protein   Int      @default(0)
  carbs     Int      @default(0)
  fat       Int      @default(0)
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}
